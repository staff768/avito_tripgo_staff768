# HTTP-сервер
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=5s
HTTP_READ_HEADER_TIMEOUT=3s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s

# Остановка сервиса
SHUTDOWN_TIMEOUT=10s

# Логи
LOG_LEVEL=info

# PostgreSQL. Реальный адрес и пароль берутся из .env, который генерирует tripgoctl
DATABASE_URL=postgres://user:password@localhost:5432/tripgo?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_QUERY_TIMEOUT=3s
